# Bill.com AP/AR API Configuration

# Developer Key: Settings > Sync & Integrations > Manage Developer Keys (required)
BILL_DEV_KEY=your_developer_key_here

# Organization ID: shown at the bottom of the Manage Developer Keys page (starts with 008)
BILL_ORGANIZATION_ID=008xxxxxxxxxxxxx

# Auth type: sync_token (recommended), full_access or session_token
BILL_AUTH_TYPE=sync_token

# Sync token: Settings > Sync & Integrations > Tokens
# BILL_USERNAME = token name, BILL_PASSWORD = token value
BILL_USERNAME=your_sync_token_name
BILL_PASSWORD=your_sync_token_value

# Environment: "sandbox" or "production"
# Defaults to production for stdio; required for http transport
BILL_ENVIRONMENT=sandbox

# Expose only read-only tools (list_* and get_*): "true" or "false"
# Defaults to true for http transport, false for stdio
# BILL_READ_ONLY=true

# Optional comma-separated list of tool names to expose
# BILL_ALLOWED_TOOLS=list_bills,get_bill,list_vendors

# --- Remote (HTTP) deployment ---
# Transport: "stdio" or "http" (defaults to http when PORT is set, otherwise stdio)
# MCP_TRANSPORT=http
# PORT=3000
# Bearer token clients must send; at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_AUTH_TOKEN=
